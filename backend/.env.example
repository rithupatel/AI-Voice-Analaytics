# AI Voice Analysis Platform - Environment Configuration

# Security
JWT_SECRET_KEY=your_secure_jwt_secret_here

# Services
REDIS_TTL_SECONDS=86400

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
HF_TOKEN=your_huggingface_token_here
LLM_TEMPERATURE=0.2

# AWS S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_ENDPOINT_URL=

# Databases
DBEAVER_DB_URL=postgresql+asyncpg://user:pass@host:5432/dbname
